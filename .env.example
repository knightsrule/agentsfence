# Configure compiler and monitoring with `agentsfence settings`.
# Credentials belong to Hermes; no AgentsFence-specific model key is needed.
# AGENTSFENCE_FOLLOWUP=amend
# AGENTSFENCE_MISSING_POLICY=fallback
# AGENTSFENCE_STRICT_YOLO=false
# AGENTSFENCE_HOME=~/.hermes/agentsfence
# AGENTSFENCE_CONFIG=
# AGENTSFENCE_LOG=warning
# Test/CI only: the interpreter of a disposable Hermes install.
# AGENTSFENCE_HERMES_PYTHON=
